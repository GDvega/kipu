<?xml version="1.0" encoding="utf-8"?>
<!--
  Financial data in kipu.db is excluded from Google cloud backup.
  User preferences (DataStore) are excluded to avoid restoring stale flags after reinstall.
  Ephemeral export cache must not leave the device via backup or transfer.
-->
<full-backup-content>
    <exclude domain="database" path="kipu.db" />
    <exclude domain="database" path="kipu.db-wal" />
    <exclude domain="database" path="kipu.db-shm" />
    <exclude domain="database" path="." />
    <exclude domain="file" path="datastore/kipu_preferences.preferences_pb" />
    <exclude domain="file" path="cache/exports/" />
</full-backup-content>
