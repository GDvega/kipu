<?xml version="1.0" encoding="utf-8"?>
<!--
  Kipu Network Security Configuration.
  Disables cleartext (HTTP) traffic explicitly across the entire app.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
