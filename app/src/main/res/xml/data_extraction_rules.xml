<?xml version="1.0" encoding="utf-8"?>
<!--
  Exclude the Room financial database from cloud backup and device transfer.
  Monetary movements must not leave the device via automatic Google backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="kipu.db" />
        <exclude domain="database" path="kipu.db-wal" />
        <exclude domain="database" path="kipu.db-shm" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/kipu_preferences.preferences_pb" />
        <exclude domain="file" path="cache/exports/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="kipu.db" />
        <exclude domain="database" path="kipu.db-wal" />
        <exclude domain="database" path="kipu.db-shm" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/kipu_preferences.preferences_pb" />
        <exclude domain="file" path="cache/exports/" />
    </device-transfer>
</data-extraction-rules>
